generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  // "library" (the default) still imports @prisma/client/runtime/library, which loads the
  // native/binary query engine to compile queries even when a driver adapter (lib/prisma.ts)
  // handles the actual DB I/O — that's why switching to an adapter alone didn't stop Vercel from
  // trying to load a query-engine binary. "client" removes the engine dependency entirely: no
  // binary, no OS/OpenSSL-variant matching, nothing to go missing on a different runtime.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migrations point at Neon's unpooled endpoint instead (see prisma.config.ts's directUrl) —
  // DATABASE_URL's pooled connection doesn't reliably hold `prisma migrate deploy`'s advisory
  // lock across its transaction-mode PgBouncer. Not set here too: unlike prisma.config.ts's
  // fallback-safe version, a schema-level `directUrl = env("DIRECT_URL")` is validated strictly
  // at build time and hard-fails if that var isn't set anywhere yet.
}

enum OutreachType {
  BRAND
  CREATOR
}

/**
 * Only meaningful for the Brand track — direct-to-brand vs. reaching the brand's agency.
 */
enum RecipientType {
  DIRECT
  AGENCY
}

enum BudgetType {
  FLAT_FEE
  COMMISSION
  PRODUCT_ONLY
  HYBRID
  UNKNOWN
}

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum EmailAccessStatus {
  CONNECTED
  NEEDS_REAUTH
  DISCONNECTED
}

enum SequenceStatus {
  NEW
  INITIAL_EMAIL_DETECTED
  WAITING_FOR_REPLY
  FOLLOW_UP_1_SENT
  FOLLOW_UP_2_SENT
  FOLLOW_UP_3_SENT
  /**
   * Only reached by the creator-list nudge cadence — a final CEO-voice close-out sent after 3
   * nudges with no reply. The standard Email 1 -> Follow-up 1/2/3 cadence never reaches this.
   */
  FOLLOW_UP_4_SENT
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  STOPPED
  PAUSED
  COMPLETED
}

/**
 * The human/business pipeline label shown on the dashboard, matching the team's own tracking
 * sheet. FIRST_EMAIL_SENT, CREATOR_LIST_REQUESTED, CREATOR_LIST_SENT, CREATOR_SELECTED (when the
 * reply names/commits to a creator) and NOT_INTERESTED are set automatically by reading the
 * thread; NEGOTIATION and DEAL — and CREATOR_SELECTED as a manual override/fallback — reflect
 * judgment calls the team can also set directly on the dashboard.
 */
enum PipelineStage {
  FIRST_EMAIL_SENT
  CREATOR_LIST_REQUESTED
  CREATOR_LIST_SENT
  NEGOTIATION
  CREATOR_SELECTED
  NOT_INTERESTED
  DEAL
}

/**
 * TEMPLATE = one of the canned Brand/Creator step templates. CREATOR_LIST_NUDGE = a nudge asking
 * whether they've had a chance to look at the creator list. TEAM_CHECK_NUDGE = a nudge asking
 * whether they've had a chance to check internally, sent after a non-committal reply.
 * GENERIC_NUDGE = a content-agnostic fallback for a manual send that doesn't fit either case.
 */
enum ScheduledActionKind {
  TEMPLATE
  CREATOR_LIST_NUDGE
  TEAM_CHECK_NUDGE
  GENERIC_NUDGE
}

enum ScheduledInitialEmailKind {
  /**
   * payload is a ComposeEmailInput — sending it creates a Brand/Creator + OutreachSequence and
   * queues the normal follow-up cadence, exactly like the guided New Outreach flow.
   */
  SEQUENCE
  /**
   * payload is a plain to/cc/bcc/subject/html/attachments send with no outreach tracking —
   * composing an email the classifier reads as neither brand nor creator outreach still gets
   * Gmail-style schedule send, it just doesn't enter the follow-up system.
   */
  PLAIN
}

/**
 * Whether an EmailMessage was sent by this system or typed directly in Gmail by the team and
 * only picked up afterward while scanning the thread.
 */
enum MessageSource {
  SYSTEM
  MANUAL
}

enum ScheduledActionStatus {
  PENDING
  SENT
  SKIPPED
  CANCELLED
  FAILED
}

enum MessageDirection {
  OUT
  IN
}

enum MessageStatus {
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum ActivityEventType {
  SEQUENCE_CREATED
  INITIAL_EMAIL_DETECTED
  FOLLOW_UP_SCHEDULED
  REPLY_CHECK_PERFORMED
  NO_REPLY_FOUND
  FOLLOW_UP_SENT
  REPLY_DETECTED
  AUTO_REPLY_DETECTED
  BOUNCE_DETECTED
  UNSUBSCRIBE_DETECTED
  SEQUENCE_PAUSED
  SEQUENCE_RESUMED
  SEQUENCE_STOPPED
  FOLLOW_UP_SKIPPED
  FOLLOW_UP_SENT_NOW
  SEQUENCE_COMPLETED
  TEMPLATE_EDITED
  MANUAL_MESSAGE_DETECTED
  GENERIC_REPLY_DETECTED
  STAGE_CHANGED
  MOVED_TO_TRASH
  RESTORED_FROM_TRASH
  MARKED_IMPORTANT
  UNMARKED_IMPORTANT
  FOLLOW_UP_CANCELLED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String?
  timezone      String         @default("Asia/Kolkata")
  role          String         @default("admin")
  createdAt     DateTime       @default(now())
  emailAccounts EmailAccount[]
}

model EmailAccount {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  provider       EmailProvider     @default(GMAIL)
  email          String            @unique
  accessToken    String?           @db.Text
  refreshToken   String?           @db.Text
  tokenExpiry    DateTime?
  accessStatus   EmailAccessStatus @default(DISCONNECTED)
  timezone       String            @default("Asia/Kolkata")
  dailySendLimit Int               @default(450)
  createdAt      DateTime          @default(now())

  /**
   * Gmail's own change cursor. Incremental syncs ask Gmail "what changed since this point"
   * instead of re-listing the mailbox, which is what keeps sync cost flat as the mailbox grows.
   * Gmail expires these after about a week, so the sync falls back to a bounded full list when
   * it's missing or rejected.
   */
  lastHistoryId String?
  inboxSyncedAt DateTime?
  /**
   * Scopes Google actually granted at connect time. Stored so the app can tell the difference
   * between "two-way inbox sync is off" and "it's broken" — an account connected before
   * gmail.modify was requested keeps working read-only until it's reconnected, and this is what
   * lets the UI say so plainly instead of failing silently.
   */
  grantedScopes String?   @db.Text

  sequences    OutreachSequence[]
  inboxThreads InboxThread[]
}

/**
 * A Gmail conversation, mirrored locally so the app has a real inbox of its own rather than a
 * notification feed pointing at Gmail. Thread-level state (read, starred, archived) is synced
 * both ways with Gmail's own labels, so acting here acts on the real mailbox and vice versa.
 * Only metadata lives here by default — message bodies are fetched on demand the first time a
 * thread is opened and then cached (bodiesFetchedAt). That keeps the sync cheap and the database
 * small no matter how large the mailbox gets, which is the difference between this working for a
 * week and working for years.
 */
model InboxThread {
  id              String            @id @default(cuid())
  emailAccountId  String
  emailAccount    EmailAccount      @relation(fields: [emailAccountId], references: [id])
  gmailThreadId   String
  subject         String
  snippet         String            @db.Text
  /**
   * Whoever the conversation is *with* — the other party, not us. What the list column shows.
   */
  fromName        String
  fromAddress     String
  lastMessageAt   DateTime
  messageCount    Int               @default(1)
  isUnread        Boolean           @default(true)
  isStarred       Boolean           @default(false)
  /**
   * No INBOX label in Gmail — archived (or never in the inbox to begin with).
   */
  isArchived      Boolean           @default(false)
  isTrashed       Boolean           @default(false)
  isSent          Boolean           @default(false)
  /**
   * Set when this conversation belongs to an outreach sequence the CRM is running, which is what
   * lets the inbox show pipeline context inline and decide follow-up handling on a reply.
   */
  sequenceId      String?
  sequence        OutreachSequence? @relation(fields: [sequenceId], references: [id])
  bodiesFetchedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  messages InboxMessage[]

  @@unique([emailAccountId, gmailThreadId])
  @@index([emailAccountId, isArchived, isTrashed, lastMessageAt])
  @@index([isUnread])
  @@index([isStarred])
  @@index([sequenceId])
}

/**
 * One message inside an InboxThread. Bodies are populated lazily — see InboxThread.
 */
model InboxMessage {
  id             String           @id @default(cuid())
  threadId       String
  thread         InboxThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  gmailMessageId String
  fromName       String
  fromAddress    String
  toAddresses    String           @db.Text
  ccAddresses    String           @default("") @db.Text
  subject        String
  snippet        String           @db.Text
  bodyText       String?          @db.Text
  bodyHtml       String?          @db.Text
  direction      MessageDirection
  sentAt         DateTime

  @@unique([threadId, gmailMessageId])
  @@index([threadId, sentAt])
}

model Brand {
  id                 String     @id @default(cuid())
  name               String
  website            String?
  category           String?
  isAgency           Boolean    @default(false)
  budgetRangeText    String?
  budgetType         BudgetType @default(UNKNOWN)
  influencerRangeMin Int?
  influencerRangeMax Int?
  deliverables       String?
  campaignTimeline   String?
  notes              String?    @db.Text
  createdAt          DateTime   @default(now())
  contacts           Contact[]
}

model Creator {
  id          String   @id @default(cuid())
  name        String
  email       String?
  channelName String?
  channelUrl  String?
  niche       String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  // --- Creator Discovery fields — all optional, so a Creator entered by hand through the
  // original New Outreach flow (which only ever sets the fields above) is unaffected. ---
  /**
   * /**
   * /**
   * /**
   * /**
   * /** YouTube's own channel id (UC...). The dedupe/upsert key across repeat searches — this is
   * what lets the Library grow into a real cache instead of re-discovering the same channel under
   * a new row every time someone searches again.
   */
  channelId        String?   @unique
  thumbnailUrl     String?
  /**
   * ISO 3166-1 alpha-2, from channels.list snippet.country.
   */
  country          String?
  subscriberCount  Int?
  /**
   * From calculateCreatorAverage() over the channel's recent uploads.
   */
  averageViews     Int?
  engagementRate   Float?
  /**
   * Most recent upload's publishedAt — powers the "posted in the last N days" freshness filter.
   */
  lastUploadAt     DateTime?
  /**
   * Auto-detected from the channel description: { instagram?, tiktok?, twitter?, pinterest?,
   * facebook?, amazonStorefront?: string }. Never live-searched — see lib/youtube/channelExtractor.ts.
   */
  platformLinks    Json      @default("{}")
  /**
   * Same data as platformLinks, flattened to just the keys present (e.g. ["instagram","tiktok"])
   * — a String[] column so the Library filter can do `hasSome: [...]` instead of a fragile
   * JSON-path query. platformLinks stays the source of truth for the actual URLs; this exists
   * purely to make "has Instagram OR TikTok" a fast, simple filter.
   */
  platformTags     String[]  @default([])
  /**
   * The channel's full About description, saved so the "media" detail view can show it (and let
   * the team re-read it) without an extra API call every time someone opens a saved creator.
   */
  description      String?   @db.Text
  /**
   * "search" for a Discovery result, null/"manual" for one entered by hand.
   */
  discoverySource  String?
  /**
   * Bumped every time a search re-surfaces this channel — a cache-freshness signal, separate
   * from lastUploadAt (which is about the creator's own posting activity).
   */
  lastDiscoveredAt DateTime?

  /**
   * Real audience demographics, entered by hand from the creator's own YouTube Studio analytics
   * when they share it with the team — the public API has no legitimate way to see a channel's
   * actual viewer age/gender/location breakdown for anyone but the channel owner, so this is
   * deliberately never inferred or estimated. Each is an array of {label, percent}; the media kit
   * only shows this section when populated, never a placeholder or a guess. See
   * lib/youtube/channelMediaKit.ts and CreatorDetailModal.tsx.
   */
  audienceCountries   Json @default("[]")
  audienceAgeRanges   Json @default("[]")
  audienceGenderSplit Json @default("[]")

  contacts Contact[]

  @@index([subscriberCount])
  @@index([lastDiscoveredAt])
}

model Contact {
  id        String   @id @default(cuid())
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [id])
  name      String
  email     String
  createdAt DateTime @default(now())

  sequences OutreachSequence[]

  @@index([email])
}

model OutreachSequence {
  id                    String         @id @default(cuid())
  outreachType          OutreachType
  recipientType         RecipientType  @default(DIRECT)
  contactId             String
  contact               Contact        @relation(fields: [contactId], references: [id])
  emailAccountId        String
  emailAccount          EmailAccount   @relation(fields: [emailAccountId], references: [id])
  threadId              String
  initialMessageId      String
  currentStep           Int            @default(0)
  status                SequenceStatus @default(NEW)
  stage                 PipelineStage  @default(FIRST_EMAIL_SENT)
  lastKnownMsgCount     Int            @default(1)
  variables             Json           @default("{}")
  /**
   * Set (and re-set on every later reply) whenever the contact replies after the creator list has
   * gone out — the dashboard's green "Response Received" indicator for that track. Also settable
   * by hand from the dashboard as a manual backstop, and cleared automatically when a fresh
   * creator list goes out for a new round.
   */
  creatorListResponseAt DateTime?
  /**
   * Gmail-style star — a manual "don't lose track of this one" flag, independent of pipeline
   * stage or status.
   */
  isImportant           Boolean        @default(false)
  /**
   * Soft-delete (Trash) — set when the team deletes a thread from the CRM; the worker stops
   * touching it (no more reply checks or scheduled sends) but the row and its history stay until
   * a separate permanent delete. Null = not in Trash.
   */
  deletedAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  /**
   * When the reply-check pass last looked at this thread. The pass is time-bounded, so it
   * processes least-recently-checked first — without that it would restart from the same order
   * every tick and anything past the cutoff would never get checked at all once there are more
   * active sequences than fit in one pass.
   */
  lastReplyCheckAt DateTime?

  scheduledActions ScheduledAction[]
  messages         EmailMessage[]
  activityLogs     ActivityLog[]
  inboxThreads     InboxThread[]

  @@unique([emailAccountId, threadId])
  @@index([deletedAt])
  @@index([isImportant])
}

/**
 * A composed-but-not-yet-sent Email 1, saved for later — Gmail's own Drafts folder. Distinct from
 * ScheduledInitialEmail (which has committed to a specific send time); a draft has neither sent
 * nor been scheduled yet, and is only ever turned into one or the other by resuming it in the
 * compose flow.
 */
model Draft {
  id             String        @id @default(cuid())
  outreachType   OutreachType
  recipientType  RecipientType @default(DIRECT)
  contactEmail   String        @default("")
  contactName    String        @default("")
  emailAccountId String?
  /**
   * The rest of the compose form, as typed — brand/creator details, subject/body overrides,
   * template variables. Same shape as ComposeEmailInput; stored as-is since a draft is inherently
   * partial/unvalidated (that's the point — it doesn't have to be ready to send yet).
   */
  payload        Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([updatedAt])
}

/**
 * A "Write & Send" (or bulk) Email 1 that the team scheduled for a future send time instead of
 * sending immediately — like Gmail's own "Schedule send." Nothing about an OutreachSequence
 * exists yet at this point (there's no thread to attach to until the email actually goes out),
 * so the full compose payload is stored as-is and replayed through the normal send path
 * (composeAndSendInitialEmail) once due.
 */
model ScheduledInitialEmail {
  id             String                    @id @default(cuid())
  scheduledAt    DateTime
  status         ScheduledActionStatus     @default(PENDING)
  kind           ScheduledInitialEmailKind @default(SEQUENCE)
  payload        Json
  sentSequenceId String?
  error          String?                   @db.Text
  createdAt      DateTime                  @default(now())
  /**
   * When it actually went out — recorded so "scheduled for X, sent at Y" is answerable directly
   * instead of inferred from the resulting sequence's first message.
   */
  sentAt         DateTime?
  /**
   * See ScheduledAction.claimedAt — same overlapping-tick protection.
   */
  claimedAt      DateTime?

  @@index([status, scheduledAt])
}

model ScheduledAction {
  id                String                @id @default(cuid())
  sequenceId        String
  sequence          OutreachSequence      @relation(fields: [sequenceId], references: [id])
  step              Int
  scheduledAt       DateTime
  status            ScheduledActionStatus @default(PENDING)
  kind              ScheduledActionKind   @default(TEMPLATE)
  templateVersion   Int?
  /**
   * Set when the team edited this specific upcoming send's preview directly — takes over from
   * the live-rendered template/nudge content when present. Cleared to go back to auto-render.
   */
  subjectOverride   String?
  bodyOverride      String?               @db.Text
  actionKey         String                @unique
  /**
   * Set when a human picked this exact send time by hand. The automatic cadence deliberately
   * lands inside the configured sending window, but an explicitly chosen time is a decision the
   * system shouldn't quietly override — these skip the send-time window clamp.
   */
  manuallyScheduled Boolean               @default(false)
  /**
   * Held by whichever tick is currently processing this row. Ticks can overlap now (the worker
   * loops every ~30s and runs can briefly run concurrently), so the send path claims a row
   * atomically before doing any Gmail work — without this, two ticks could both read PENDING and
   * both send. Cleared when the row is left pending; a claim older than CLAIM_STALE_MS is treated
   * as abandoned so a tick killed mid-send can't strand the row forever.
   */
  claimedAt         DateTime?

  @@index([status, scheduledAt])
}

model EmailMessage {
  id                String           @id @default(cuid())
  sequenceId        String
  sequence          OutreachSequence @relation(fields: [sequenceId], references: [id])
  providerMessageId String
  direction         MessageDirection
  source            MessageSource    @default(SYSTEM)
  subject           String
  body              String           @db.Text
  sentAt            DateTime
  status            MessageStatus    @default(SENT)

  @@index([sequenceId])
}

model Template {
  id            String        @id @default(cuid())
  outreachType  OutreachType
  recipientType RecipientType @default(DIRECT)
  step          Int
  name          String
  subject       String
  body          String        @db.Text
  version       Int           @default(1)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([outreachType, recipientType, step, version])
  @@index([outreachType, recipientType, step, isActive])
}

model ActivityLog {
  id          String            @id @default(cuid())
  sequenceId  String?
  sequence    OutreachSequence? @relation(fields: [sequenceId], references: [id])
  eventType   ActivityEventType
  description String
  timestamp   DateTime          @default(now())

  @@index([sequenceId])
}

model SuppressedContact {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model WorkerHeartbeat {
  id             String   @id @default(cuid())
  lastRunAt      DateTime
  lastRunOk      Boolean  @default(true)
  lastError      String?  @db.Text
  actionsChecked Int      @default(0)

  /**
   * Ticks now run every ~30s so due sends land close to their scheduled minute, but the inbox
   * passes don't need (and shouldn't burn) that cadence in Gmail API quota — these two stamps let
   * each pass run on its own slower interval while the send pass runs every single tick.
   */
  lastReplyCheckAt  DateTime?
  lastInboxScanAt   DateTime?
  /**
   * Anti-burst spacing without blocking the function: after each send this is pushed forward by
   * a random gap from AutomationSettings, and no send happens before it. Replaces sleeping inside
   * the tick, which doesn't work once ticks are short and frequent.
   */
  nextSendAllowedAt DateTime?
}

model AutomationSettings {
  id                    String   @id @default(cuid())
  /**
   * Business days from Email 1 to Follow-up #1 (default: next business day).
   */
  brandDelayDays1       Int      @default(1)
  /**
   * Business days from Follow-up #1 to Follow-up #2.
   */
  brandDelayDays2       Int      @default(2)
  /**
   * Business days from Follow-up #2 to Follow-up #3 — after this, no reply moves the sequence
   * to Completed and the pipeline stage to Not Interested automatically.
   */
  brandDelayDays3       Int      @default(2)
  creatorDelayDays1     Int      @default(1)
  creatorDelayDays2     Int      @default(2)
  creatorDelayDays3     Int      @default(2)
  sendWindowStartHour   Int      @default(9)
  sendWindowStartMinute Int      @default(30)
  sendWindowEndHour     Int      @default(12)
  sendWindowEndMinute   Int      @default(0)
  sendWindowDays        String   @default("MON,TUE,WED,THU,FRI")
  sendSpacingSecondsMin Int      @default(30)
  sendSpacingSecondsMax Int      @default(180)
  /**
   * Days to wait before nudging again after a non-committal reply ("ok, will check and revert").
   */
  nonCommittalDelayDays Int      @default(2)
  updatedAt             DateTime @updatedAt
}

/**
 * A generated Insight OS report for a single YouTube video.
 * The report itself is a deeply nested document (hero stats, comment intelligence, estimates, AI
 * verdict) that nothing ever queries *into* — it's written once and rendered whole. So it lives in
 * a JSON column rather than being shredded across dozens of relational tables. The handful of
 * fields the reports list sorts and displays are lifted into real columns so that view doesn't
 * have to parse every document to draw a table.
 */
model InsightReport {
  id             String    @id @default(cuid())
  videoId        String
  videoUrl       String
  videoTitle     String
  channelId      String
  channelTitle   String
  thumbnailUrl   String?
  viewCount      Int       @default(0)
  engagementRate Float     @default(0)
  /**
   * The engine's overall 0-100 score, shown as "AI Score" in the reports list.
   */
  finalScore     Float     @default(0)
  verdict        String?
  publishedAt    DateTime?
  data           Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shares InsightReportShare[]

  @@index([createdAt])
  @@index([videoId])
  @@index([channelId])
}

/**
 * A no-login link to one report. The token is the access control, so it's random and unique.
 */
model InsightReportShare {
  id        String        @id @default(cuid())
  token     String        @unique
  reportId  String
  report    InsightReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  /**
   * Set to withdraw a link that's already been sent out, without deleting the report.
   */
  revokedAt DateTime?

  @@index([reportId])
}

/**
 * A running daily total of YouTube Data API quota units spent, across all rotated keys combined.
 * Key rotation itself (lib/youtube/api.ts) is purely reactive — it only finds out a key is out of
 * quota when a call fails with 403/429. This is the one proactive signal: search.list costs 100
 * units against 1 for a lookup call, so Discovery writes here after every search and the UI reads
 * it back to show "~X units used today" and soft-warn well before quota actually runs out.
 */
model YoutubeApiUsage {
  id        String   @id @default(cuid())
  /**
   * "YYYY-MM-DD" — one row per day.
   */
  date      String   @unique
  units     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/**
 * A whole-channel performance report — deliberately separate from InsightReport, which is scored
 * against one specific video. This is the document actually meant to be handed to a brand: "should
 * we work with this creator at all," not "did this one upload do well." Regenerated fresh each
 * time (no upsert-by-channel) since a brand conversation usually wants the numbers as of right now.
 */
model ChannelMediaKit {
  id                   String                 @id @default(cuid())
  channelId            String
  channelTitle         String
  channelUrl           String
  thumbnailUrl         String?
  country              String?
  niche                String?
  subscriberCount      Int                    @default(0)
  // A big channel's lifetime view count comfortably exceeds Postgres INTEGER's ~2.1B ceiling
  // (confirmed against a real 3.3B-view channel while testing this) — BigInt is the only field
  // here that actually needs it; per-video/per-average counts never get close.
  totalViewCount       BigInt                 @default(0)
  videoCount           Int                    @default(0)
  averageViews         Int                    @default(0)
  engagementRate       Float                  @default(0)
  /**
   * averageViews as a percentage of subscriberCount — how much of the audience actually watches
   * each upload, the single number brands ask about most after subscriber count itself.
   */
  viewToSubscriberRate Float                  @default(0)
  /**
   * 0-100, see lib/youtube/channelMediaKit.ts's computeBrandFitScore for the formula.
   */
  brandFitScore        Float                  @default(0)
  uploadFrequencyLabel String?
  /**
   * Everything the report page renders beyond the lifted columns above: top/recent videos,
   * category breakdown, platform links, sample comments, and the AI narrative sections.
   */
  data                 Json
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  shares               ChannelMediaKitShare[]

  @@index([createdAt])
  @@index([channelId])
}

/**
 * A no-login link to one channel media kit — mirrors InsightReportShare exactly (see that model
 * for why the token, not the id, is the access control).
 */
model ChannelMediaKitShare {
  id         String          @id @default(cuid())
  token      String          @unique
  mediaKitId String
  mediaKit   ChannelMediaKit @relation(fields: [mediaKitId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  revokedAt  DateTime?

  @@index([mediaKitId])
}
